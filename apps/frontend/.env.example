# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (optional). Only the predictions page needs a login; without these
# keys the rest of the site works and predictions show a "sign-in not
# switched on" notice. The backend needs the matching CLERK_ISSUER.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
